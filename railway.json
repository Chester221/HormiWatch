{
  "services": [
    {
      "name": "backend",
      "root": ".",
      "buildCommand": "cd backend && npm install && npm run build",
      "startCommand": "cd backend && npm run start:prod",
      "healthcheckPath": "/api/v1/health",
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  ]
}